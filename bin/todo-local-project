#!/bin/bash
set -o pipefail
shopt -qs extglob
${DEBUG:+eval $(debugtrace -o $- -- "$@")}

readonly scriptDir="$([ "${BASH_SOURCE[0]}" ] && dirname -- "${BASH_SOURCE[0]}" || exit 3)"
[ -d "$scriptDir" ] || { echo >&2 'ERROR: Cannot determine script directory!'; exit 3; }
readonly projectDir="${scriptDir}/.."
readonly varDir="${projectDir}/var"

printUsage()
{
    cat <<HELPTEXT
Synthesize (and record) an origin +project [@work] for the passed local todo.txt
LOCAL-TODO-DIR / a project for the current working directory. Fails with 1 if
the origin +project cannot be determined, and with 5 if not in a project
directory.
HELPTEXT
    echo
    printf 'Usage: todo.sh -p list ... | %q %s\n' "$(basename "$1")" '--to-dir'
    echo
    cat <<HELPTEXT
Discover and record origin +project [@work] from source directories.
HELPTEXT
    echo
    printf 'Usage: %q %s\n' "$(basename "$1")" '--discover'
    echo
    cat <<HELPTEXT
List all recorded origin +project [@work].
HELPTEXT
    echo
    printf 'Usage: %q %s\n' "$(basename "$1")" '-l|--list'
    echo
    cat <<HELPTEXT
List all origin +project [@work] and the recorded corresponding DIRs.
HELPTEXT
    echo
    printf 'Usage: %q %s\n' "$(basename "$1")" '-s|--show-records'
    echo
    printf 'Usage: %q %s\n' "$(basename "$1")" '--to-origin [LOCAL-TODO-DIR]'
    echo
    cat <<HELPTEXT
Print the corresponding recorded directory if a single recorded origin +project
[@work] is found in the task text read from standard input. Fails with 5 if no
or with 1 if multiple recorded origin +projects are found in the task text.
HELPTEXT
}
typeset -a pager=("${PAGER:-less}" --RAW-CONTROL-CHARS); [ -t 1 ] || pager=()

action='printUsage'
case "$1" in
    --help|-h|-\?)      shift; printUsage "$0"; exit 0;;
    --to-origin)        shift; action=toOrigin; pager=();;
    --to-dir)           shift; action=toDir; pager=();;
    --discover)		shift; action=discover; pager=();;
    --list|-l)		shift; action=list;;
    --show-records|-s)	shift; action=showRecords;;
    *)                  printUsage "$0" >&2; exit 2;;
esac

database()
{
    nanoDB --basedir "$varDir" --relaxed-key --table todo-local-project "$@"
}

printOrigin()
{
    printf '%s\n' "$@"

    IFS=' '
    database --update "$*" --value "${localDirspec:?}"
}

toOrigin()
{
    local localDirspec
    case $# in
	0)  localDirspec="$(todo-local.sh location)" || exit 5;;
	1)  localDirspec="${1:?}"; shift;;
	*)  printUsage "$0" >&2; exit 2;;
    esac

    localDirspec="${localDirspec/\/Unixhome\//\/}"
    case "$localDirspec" in
	~/@(autosource|profile))
	    printOrigin "+rc-${localDirspec##*/}";;
	~/lib/ingo/todo.txt-cli)
	    printOrigin "+todo.txt";;
	~/lib/ingo/todo.txt-cli-ex)
	    printOrigin "+todo.ex";;
	~/@(bin|lib)/@(forks|ingo)/+([^/]))
	    printOrigin "+sw-${localDirspec##*/}";;
	~/@(bin|lib)/originals/+([^/]))
	    printOrigin "+swdev-${localDirspec##*/}";;
	~/@(bin|lib)/setups/+([^/]))
	    printOrigin "+setup-${localDirspec##*/}";;
	~/@(bin|lib)/xt/+([^/]))
	    printOrigin "+tools-${localDirspec##*/}";;
	~/@(bin|lib)/*(z)ingo-customizations/+([^/]))
	    printOrigin "+customizations-${localDirspec##*/}";;
	~/swdev/test*([^/]))
	    printOrigin "+${localDirspec##*/}";;
	~/@(bin|lib)/work-+([^/])/+([^/]))
	    context="${localDirspec%/*}"; context="${context##*/}"; context="${context#*-}"
	    printOrigin "+${localDirspec##*/}" "@${context,,}";;
	~/@(bin|lib)/*(z)work-+([^/])-xt/+([^/]))
	    context="${localDirspec%/*}"; context="${context##*/}"; context="${context#*-}"; context="${context%-xt}"
	    printOrigin "+${localDirspec##*/}" "@${context,,}";;
	~/.vim/pack/@(forks|ingo)/+([^/])/+([^/]))
	    name="${localDirspec##*/}"; name="${name#vim-}"; name="${name%.vim}"
	    printOrigin "+vimrc-${name}";;
	~/.vim/pack/originals/+([^/])/+([^/]))
	    name="${localDirspec##*/}"; name="${name#vim-}"; name="${name%[.-]vim}"
	    printOrigin "+vimdev-${name}";;
	*)  return 1;;
    esac
}

discover()
{
    # Work repositories define git-WORK commands that iterate over all work-related
    # Git repositories (typically in ~/WORK/.
    # Any work-related personal projects / customizations inside Unixhome are
    # covered by Unixhome-ingo instead.
    typeset -a workSources=()
    for workName in "${!WORK_@}"
    do
	workName="${workName#WORK_}"
	workName="${workName,,}"
	workSources+=("git-$workName")
    done

    for sourceIterator in \
	{Unixhome,vimrc}-{ingo,originals} \
	swdev \
	"${workSources[@]}"
    do
	if type -t -- "$sourceIterator" >/dev/null; then
	    "$sourceIterator" --quiet --no-pager --no-header -c 'todo-local-project --to-origin'
	else
	    printf >&2 'Warning: No source iterator "%s" found; skipping.\n' "$sourceIterator"
	fi
    done \
	| sampleLines --initial-delay 2 --inline-or-none --clear --count 'project'
}

list()
{
    database --query-keys \
	| sort
}

showRecords()
{
    database --get-as-list $'\t' \
	| sort \
	| column -s $'\t' -t
}

toDir()
{
    typeset -a origins; readarray -t origins < <(list </dev/null)
    if [ ${#origins[@]} -eq 0 ]; then
	echo >&2 'ERROR: No origin +projects have been recorded in the database yet.'
	exit 5
    fi
    typeset -a originGrepArgs=("${origins[@]/#/--regexp= }"); originGrepArgs=("${originGrepArgs[@]/%/ }")

    typeset -a foundOrigins; readarray -t foundOrigins < <(
	suffix ' ' \
	    | grep --only-matching --fixed-strings "${originGrepArgs[@]}" \
	    | sort --unique
    )

    [ ${#foundOrigins[@]} -eq 1 ] || exit 1
    local foundOrigin="${foundOrigins[0]}"; foundOrigin="${foundOrigin# }"; foundOrigin="${foundOrigin% }"

    database --query "$foundOrigin"
}

eval '$action "$@"' \
    "${pager:+|}" '"${pager[@]}"'
